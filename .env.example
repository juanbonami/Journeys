DATABASE_URL=postgres://postgres:dev@localhost:5432/journeys
REDIS_URL=redis://localhost:6379
API_PORT=3000

# smtp (Mailpit, local) | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM="Journeys <hello@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# only needed when EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
# AWS credentials come from the standard AWS env vars / profile
SES_CONFIGURATION_SET=

# Milestone 1 wait duration in seconds (override the seed's wait for quick testing)
SEED_WAIT_SECONDS=60
